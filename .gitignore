# ============================================
# OptiGemma .gitignore
# ============================================

# === Node.js / Frontend ===
node_modules/
build/
dist/
coverage/
*.log

# === Environment & Secrets ===
.env*
!.env.example
*.key

# === Python Cache ===
__pycache__/
*.pyc
*.pyo
*.egg-info/

# === Virtual Environment ===
venv/
env/
.venv/

# === Large Model Files (too big for GitHub) ===
*.h5
*.pt
*.pth
*.onnx
*.onnx.data
best_model_final.pt
models/*.h5
models/*.pt
models/vessel_model/*.pt
models/vessel_model/*.pth
models/onnx/

# === Archives & Third-Party Tools ===
*.zip
gemini-web2api-main/

# === Database ===
optigemma.db

# === Generated Files ===
results/
uploads/
newprint.pdf

# === Downloaded Dataset Images ===
data/heimed/*.jpg
data/heimed/*.meta
data/heimed/*.GND
data/heimed/validation_report.json
data/aptos/

# === Sample Data (auto-generated) ===
sample_data/*
!sample_data/test_fundus.jpg

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo

# === OS Files ===
.DS_Store
Thumbs.db
desktop.ini

# === Gemini/Antigravity ===
.gemini/
.agents/
